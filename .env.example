# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# ---------------------------------------------------------------- server
# TRANSPORT=http                 # http | stdio
# PORT=8000                      # host port published by docker compose
# BUILD_PROXY=http://http.docker.internal:3128   # docker compose build: proxy for PyPI/apt
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text                # text | json (json is the default in Docker)
# Required if the server is reachable by anyone but you. Generate a token:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# One token per agent, `name:token` pairs (recommended). Each agent sends its own token in
# `Authorization: Bearer <token>`. The server tells agents apart by their token, which is the
# only way to do so for clients on the stateless MCP protocol (PIX Operator is one):
# AUTH_TOKENS=pix-1:...,pix-2:...
# One shared token instead. Stateless clients using it all count as one agent and share the
# browser, so do not set it next to AUTH_TOKENS:
# AUTH_TOKEN=

# ------------------------------------------------- one agent at a time
# The server has one browser. The first agent to call a tool gets it and keeps it, however long
# it is idle, until another agent asks for it.
# BROWSER_HANDOVER_IDLE_SECONDS=60   # another agent takes over after the current one idles this long;
#                                    # must exceed the agent's longest pause between steps
# BROWSER_BUSY_WAIT_SECONDS=20       # how long another agent's call waits before "busy"; keep it
#                                    # below your MCP client's request timeout
# BROWSER_SESSION_MAX_SECONDS=1800   # after this a waiting agent takes over even from an active
#                                    # one (when its current call ends); 0 = no limit

# --------------------------------------------------------------- browser
# BROWSER_HEADLESS=true          # false shows the window (not in Docker)
# BROWSER_WINDOW_SIZE=1280x900   # viewport; screenshots and click coordinates use it
# Proxy for Chromium traffic. Needed in Docker when the host reaches the internet through a
# local proxy/VPN that answers DNS with fake addresses (Proxifier and similar): inside the
# container those addresses point nowhere. Docker Desktop's built-in proxy goes through the host.
# Docker only: without Docker this address does not work and every page fails to load.
# BROWSER_PROXY=http://http.docker.internal:3128
# BROWSER_PROXY_BYPASS=localhost,127.0.0.1
# BROWSER_ALLOWED_DOMAINS=*.wikipedia.org,example.com   # empty = any
# BROWSER_PROHIBITED_DOMAINS=
# BROWSER_BLOCK_IP_ADDRESSES=false   # true blocks URLs with IP addresses (not host names such as localhost)
# BROWSER_ENABLE_EXTENSIONS=false

# ----------------------------------------------------------------- tools
# BROWSER_ACTION_TIMEOUT_SECONDS=60
# BROWSER_STATE_MAX_CHARS=12000      # page state returned after every action
# BROWSER_READ_MAX_CHARS=30000       # chunk size of browser_read
# BROWSER_SCREENSHOT_QUALITY=70      # JPEG quality
