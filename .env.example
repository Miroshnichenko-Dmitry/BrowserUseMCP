# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# ---------------------------------------------------------------- server
# ENDPOINTS=browser,agent        # /mcp/browser (low-level tools), /mcp/agent (LLM agent)
#                                # ENDPOINTS=browser runs without any LLM
# TRANSPORT=http                 # http | stdio
# STDIO_ENDPOINT=browser         # stdio carries one endpoint: browser | agent
# PORT=8000                      # host port published by docker compose
# BUILD_PROXY=http://http.docker.internal:3128   # docker compose build: proxy for PyPI/apt
# LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text                # text | json (json is the default in Docker)
# Required if the server is reachable by anyone but you. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_TOKEN=
# BROWSER_AUTH_TOKEN=            # overrides AUTH_TOKEN for /mcp/browser
# AGENT_AUTH_TOKEN=              # overrides AUTH_TOKEN for /mcp/agent

# ------------------------------------------------------------------- LLM
# Used only by /mcp/agent. Current default: small local model in Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
# Outside Docker:  http://localhost:11434
# Docker → host:   http://host.docker.internal:11434   (compose default)
# Docker → ollama container (compose --profile ollama): http://ollama:11434
# LLM_BASE_URL=
# browser-use prompts are large; keep >= 16384 or the model "forgets" to finish
OLLAMA_NUM_CTX=32768
# OLLAMA_THINK=false             # disable reasoning on thinking models for speed
# LLM_TIMEOUT_SECONDS=120

# --- Heavier model, pick one block ------------------------------------
# Bigger local model (any model you have pulled with `ollama pull`):
# LLM_MODEL=qwen3.5:27b
#
# OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# LLM_API_KEY=sk-...
#
# Anthropic:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# LLM_API_KEY=sk-ant-...
#
# Google:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...
#
# Any OpenAI-compatible server (vLLM, LM Studio, OpenRouter, llama.cpp):
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:1234/v1
# LLM_MODEL=qwen3.5-27b
# LLM_API_KEY=optional

# ----------------------------------------------------------------- agent
# AGENT_MAX_STEPS=40             # default step budget per task
# AGENT_MAX_STEPS_LIMIT=150      # upper bound a client may request
# AGENT_MAX_FAILURES=3
# AGENT_MAX_ACTIONS_PER_STEP=3   # small models do better with fewer actions per step
# AGENT_STEP_TIMEOUT_SECONDS=180
# AGENT_USE_VISION=true          # true | false | auto
# AGENT_USE_JUDGE=false          # extra LLM call grading the run
# AGENT_FLASH_MODE=false         # faster, less reasoning; good with strong models

# --------------------------------------------------------------- browser
# Shared by both endpoints.
# MAX_BROWSERS=2                 # Chromium instances alive at once (~300-500 MB each)
# BROWSER_HEADLESS=true          # false shows the window (not in Docker)
# BROWSER_WINDOW_SIZE=1280x900   # viewport; screenshots and click coordinates use it
# Proxy for Chromium traffic. Needed in Docker when the host reaches the internet through a
# local proxy/VPN that answers DNS with fake addresses (Proxifier and similar): inside the
# container those addresses point nowhere. Docker Desktop's built-in proxy goes through the host:
# BROWSER_PROXY=http://http.docker.internal:3128
# BROWSER_PROXY_BYPASS=localhost,127.0.0.1
# BROWSER_ALLOWED_DOMAINS=*.wikipedia.org,example.com   # empty = any
# BROWSER_PROHIBITED_DOMAINS=
# BROWSER_BLOCK_IP_ADDRESSES=false                      # true blocks localhost/LAN too
# BROWSER_ENABLE_EXTENSIONS=false

# ------------------------------------------------- /mcp/browser sessions
# BROWSER_SESSION_IDLE_SECONDS=600     # close a browser nobody used for this long
# BROWSER_MAX_SESSIONS_PER_CLIENT=3
# BROWSER_OPEN_WAIT_SECONDS=15         # wait for a free browser before "all busy"
# BROWSER_ACTION_TIMEOUT_SECONDS=60
# BROWSER_STATE_MAX_CHARS=12000        # page state returned after every action
# BROWSER_READ_MAX_CHARS=30000         # chunk size of browser_read
# BROWSER_SCREENSHOT_QUALITY=70        # JPEG quality

# ----------------------------------------------------------------- tasks
# MAX_CONCURRENT_TASKS=1         # each task = one Chromium + LLM calls; <= MAX_BROWSERS
# MAX_QUEUED_TASKS=10
# TASK_TIMEOUT_SECONDS=900
# TASK_CANCEL_GRACE_SECONDS=15
# TASK_RESULT_TTL_SECONDS=3600
# WAIT_DEFAULT_SECONDS=50        # keep below your MCP client's request timeout
# WAIT_MAX_SECONDS=300

# ------------------------------------------------------------- artifacts
# ARTIFACTS_DIR=/data/artifacts  # history.json per task (compose default)
# ARTIFACTS_SAVE_GIF=false
